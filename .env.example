# ============================================================
#  Ortam Değişkenleri — Vercel > Project > Settings > Environment Variables
#  (Yerelde test için bu dosyayı .env.local olarak kopyalayıp doldur.)
# ============================================================

# --- Alastyr cPanel MySQL bağlantısı ---
# Bu bilgileri cPanel > MySQL Databases ve Remote MySQL bölümünden alırsın.
MYSQL_HOST=          # örn: srvX.alastyr.com veya sunucunun IP'si
MYSQL_PORT=3306
MYSQL_USER=          # örn: kullaniciadi_dbuser
MYSQL_PASSWORD=
MYSQL_DATABASE=      # örn: kullaniciadi_serap
# Sunucu uzaktan SSL istiyorsa true yap, istemiyorsa boş bırak:
MYSQL_SSL=
# (Opsiyonel) eşzamanlı bağlantı sayısı — paylaşımlı hosting'de düşük tut:
MYSQL_POOL=3

# Giriş güvenliği için imza anahtarı — uzun, rastgele bir metin gir.
# Örnek üretmek için: openssl rand -base64 32
JWT_SECRET=

# Satıcının WhatsApp numarası (başında ülke kodu, boşluksuz). Örn: 905551112233
VITE_SELLER_WHATSAPP=

# Mağaza adı (başlıklarda kullanılır)
VITE_STORE_NAME=Serap Ercan
