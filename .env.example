# ============================================================
#  Ortam Değişkenleri — Vercel > Project > Settings > Environment Variables
#  (Yerelde test için bu dosyayı .env.local olarak kopyalayıp doldur.)
# ============================================================

# Vercel Postgres bağlandığında OTOMATİK eklenir — elle girmene gerek yok.
POSTGRES_URL=

# Giriş güvenliği için imza anahtarı — uzun, rastgele bir metin gir.
# Örnek üretmek için: openssl rand -base64 32
JWT_SECRET=

# Satıcının WhatsApp numarası (başında ülke kodu, boşluksuz). Örn: 905551112233
VITE_SELLER_WHATSAPP=

# Mağaza adı (başlıklarda kullanılır)
VITE_STORE_NAME=Serap Ercan
